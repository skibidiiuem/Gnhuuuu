    script
         Canvas Particle System Setup
        const canvas = document.getElementById('heart-canvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () = {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

         Endless Falling Hearts Class
        class FallingHeart {
            constructor() {
                this.reset();
            }

            reset() {
                this.x = Math.random()  width;
                this.y = -20 - Math.random()  80;
                this.size = Math.random()  14 + 8;
                this.speedY = Math.random()  1.8 + 0.8;
                this.speedX = Math.sin(Math.random()  Math.PI)  0.8 - 0.4;
                this.opacity = Math.random()  0.6 + 0.4;
                this.rotation = Math.random()  Math.PI  2;
                this.rotationSpeed = (Math.random() - 0.5)  0.03;
                this.color = `hsl(${Math.random()  25 + 335}, 100%, ${Math.random()  20 + 65}%)`;
            }

            update() {
                this.y += this.speedY;
                this.x += Math.sin(this.y  0.015) + this.speedX;
                this.rotation += this.rotationSpeed;

                if (this.y  height + 30) {
                    this.reset();
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                ctx.globalAlpha = this.opacity;
                ctx.fillStyle = this.color;

                ctx.beginPath();
                const topCurveHeight = this.size  0.3;
                ctx.moveTo(0, topCurveHeight);
                ctx.bezierCurveTo(-this.size  2, -topCurveHeight, -this.size, this.size  3, 0, this.size);
                ctx.bezierCurveTo(this.size, this.size  3, this.size  2, -topCurveHeight, 0, topCurveHeight);
                ctx.closePath();
                ctx.fill();

                ctx.restore();
            }
        }

         Click Burst Heart Particle Class
        class BurstHeart {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.size = Math.random()  16 + 10;
                const angle = Math.random()  Math.PI  2;
                const speed = Math.random()  6 + 2;
                this.vx = Math.cos(angle)  speed;
                this.vy = Math.sin(angle)  speed - 1;
                this.life = 1;
                this.decay = Math.random()  0.03 + 0.02;
                this.color = `hsl(${Math.random()  30 + 330}, 100%, 65%)`;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.vy += 0.1;  gravity
                this.life -= this.decay;
            }

            draw() {
                if (this.life = 0) return;
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.globalAlpha = this.life;
                ctx.fillStyle = this.color;

                ctx.beginPath();
                const topCurveHeight = this.size  0.3;
                ctx.moveTo(0, topCurveHeight);
                ctx.bezierCurveTo(-this.size  2, -topCurveHeight, -this.size, this.size  3, 0, this.size);
                ctx.bezierCurveTo(this.size, this.size  3, this.size  2, -topCurveHeight, 0, topCurveHeight);
                ctx.closePath();
                ctx.fill();

                ctx.restore();
            }
        }

         Initialize particles
        const fallingHeartsCount = 50;
        const fallingHearts = [];
        const burstHearts = [];

        for (let i = 0; i  fallingHeartsCount; i++) {
            const heart = new FallingHeart();
            heart.y = Math.random()  height;  Spread initially
            fallingHearts.push(heart);
        }

         Main animation render loop
        function render() {
            ctx.clearRect(0, 0, width, height);

             Render falling hearts
            fallingHearts.forEach(h = {
                h.update();
                h.draw();
            });

             Render burst hearts
            for (let i = burstHearts.length - 1; i = 0; i--) {
                const b = burstHearts[i];
                b.update();
                b.draw();
                if (b.life = 0) {
                    burstHearts.splice(i, 1);
                }
            }

            requestAnimationFrame(render);
        }

         Interactive Click Burst
        window.addEventListener('pointerdown', (e) = {
             Don't burst if clicking modal buttons
            if (e.target.closest('#heart-modal')) return;

            for (let i = 0; i  12; i++) {
                burstHearts.push(new BurstHeart(e.clientX, e.clientY));
            }
        });

         Modal Handlers
        function openHeartModal(e) {
            if (e) e.stopPropagation();
            const modal = document.getElementById('heart-modal');
            modal.classList.remove('hidden');
            
             Trigger 20 burst particles at heart center
            for (let i = 0; i  25; i++) {
                burstHearts.push(new BurstHeart(window.innerWidth  2, window.innerHeight  2));
            }
        }

        function closeHeartModal() {
            document.getElementById('heart-modal').classList.add('hidden');
        }

         Web Audio Synthesizer for Cute Chill Background Melody
        let isMusicPlaying = false;
        let audioCtx = null;
        let melodyInterval = null;

        function playCuteNote(freq, duration = 0.3) {
            if (!audioCtx) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.log(e);
            }
        }

        function toggleMusic() {
            const btnText = document.getElementById('music-text');
            const btnIcon = document.getElementById('music-icon');

            if (!isMusicPlaying) {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext  window.webkitAudioContext)();
                }
                audioCtx.resume();
                isMusicPlaying = true;
                btnText.innerText = Tắt nhạc 🎵;
                btnIcon.className = fa-solid fa-volume-high animate-bounce;

                 Pentatonic cute scale sequence
                const notes = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25, 587.33, 659.25];
                let step = 0;

                melodyInterval = setInterval(() = {
                    if (!isMusicPlaying) return;
                    const freq = notes[step % notes.length];
                    playCuteNote(freq, 0.4);
                    
                     Harmony soft second note occasionally
                    if (step % 3 === 0) {
                        playCuteNote(freq  1.25, 0.3);
                    }
                    step++;
                }, 380);
            } else {
                isMusicPlaying = false;
                if (melodyInterval) clearInterval(melodyInterval);
                btnText.innerText = Bật nhạc chill 🎵;
                btnIcon.className = fa-solid fa-music;
            }
        }

         Start animation loop on window load
        window.onload = function() {
            render();
        };
    script
